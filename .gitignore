/target
**/*.rs.bk
*.log
.DS_Store
.idea/
.vscode/
*.swp
*.swo
.context/
# .claude/skills/ holds the repo's shared skills (read by Claude Code directly,
# by Pi through the .agents/skills symlink); everything else stays local.
.claude/*
!.claude/skills/
temp/
__pycache__/
*.pyc
*.pyo
*.pyd
*.egg-info/
.venv/
*.profraw
# vulkaninfo profile dumps written into cwd by the Vulkan probe
VP_VULKANINFO_*.json

# lemond writes its backend cache here when run from the repo root
/backends/

# skip local bench scripts
.auto/*
scripts/bench/local/.auto/
